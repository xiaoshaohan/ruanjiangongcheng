# 复制本文件为 .env 后填写真实配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=student_portrait
PORT=3000

# JWT 签名密钥：必填，至少 32 个字符，缺失或过短时服务会拒绝启动
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为至少32位的随机字符串

# 请求体上限（导入 5000 行需要较大空间）
BODY_LIMIT=10mb

# 允许跨域访问的来源，逗号分隔；留空表示只允许同源
# 例如：CORS_ORIGINS=http://10.100.113.166:3000,http://localhost:3000
CORS_ORIGINS=

# 首次初始化管理员时使用的口令：sys_user 为空时必填，缺失会拒绝启动
# 至少 8 位，且不能是 admin123、12345678 等常见弱口令
ADMIN_INIT_PASSWORD=请替换为至少8位的强口令
